# FOR PUBLIC VALUES. DO NOT STORE SECRETS HERE.
# USED FOR BOTH VITE(CLIENT) AND BUN(SERVER).

# 2025-09-12. Actual date. Later libs and deployment requirements can be changed easily.
# Two days ago i had this case when requirements for bun websocket changed(silently) after upgrade the bun version.
# Two hours to solve, but yesterday it was ok. AI (bun's custom AI bot from their site) lied. New requirements said one more variable required. Finally the "undefined" and [] worked, but other types failed. Be careful with these cases.

# Planned to deploy on koyeb, since tested and had free plan(good for start).

# The koyeb supports docker containers for bun.

# print development messages using devlog(decorative) and rawlog(without frame) functions, false - ignore prints
DEVLOG=true

# print error messages using errlog function, false - ignore prints.
# TURN OFF CAREFULLY, since server will keep silence in case of errors.
ERRLOG=true

# ip 0.0.0.0 to listen inside docker container to all connections. Otherwise have to listen to at least one ip.  localhost - to allow browsers, or they complain to CORS.
# Bind to all interfaces (required for Docker access).
HOST=0.0.0.0
# it will be headache to properly manipulate this ... magic on deploy
VITE_SERVER_HOST=space-sphere-shooter-server.onrender.com
# to switch from default 5173 for client
VITE_CLIENT_HOST=localhost

# port to listen to inside docker container. The koyeb deployment does not have extra requirements for the port. But f.e. onrender.com has reqirements(port 443 must be used for websockets).
# In the same time access to port 443 on linux requires root permissions.
PORT=5000
# stupid prefix requirement
VITE_SERVER_PORT=5000
VITE_CLIENT_PORT=3000

# the size of RAM available for deployment environment. 0 - no limits(does not look reasonable)
RAM_SIZE_MB=512

# websocket message size limit in kilobytes, to close the connection in case of potential manipulations
LIMIT_KB=2

# maximum of the connected users. After half of this value the autolimit starts. The 0 means unlimited
USERS_MAX_NUMBER=100
